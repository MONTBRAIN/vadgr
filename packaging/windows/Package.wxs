<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <Package
      Name="Vadgr"
      Manufacturer="MONTBRAIN"
      Version="$(var.VadgrVersion)"
      ProductCode="{CEFD8482-734F-403D-B9BB-5ABD06A2A79E}"
      UpgradeCode="{5504409E-BAA2-4B82-9BA1-CB6C45E5EACB}"
      Scope="perUser"
      InstallerVersion="500">
    <SummaryInformation Description="Vadgr local machine agent" />
    <MajorUpgrade
        Schedule="afterInstallInitialize"
        AllowDowngrades="yes" />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />
    <Property Id="TERMSACCEPTED" Secure="yes" />
    <Property Id="TERMSVERSION" Secure="yes" />
    <Property Id="BUNDLESOURCE" Secure="yes" Hidden="yes" />
    <Property Id="PURGEOWNERDATA" Secure="yes" />
    <Launch
        Condition="Installed OR TERMSACCEPTED = 1"
        Message="Install Vadgr through its setup application and accept the current terms first." />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsDirectory" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="Vadgr">
          <Directory Id="PackageCacheFolder" Name="cache" />
          <Directory Id="PrivateLibFolder" Name="lib" />
          <Directory Id="LegalFolder" Name="legal" />
          <Directory Id="SbomFolder" Name="sbom" />
        </Directory>
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="Vadgr" />
    </StandardDirectory>

    <Feature Id="Complete" Title="Vadgr" Level="1">
      <ComponentRef Id="VadgrBackend" />
      <ComponentRef Id="VadgrApplication" />
      <ComponentRef Id="InstallFolderCleanup" />
      <ComponentRef Id="StartMenuEntry" />
      <ComponentRef Id="StartupEntry" />
      <ComponentRef Id="PackageCacheCleanup" />
      <!--
        Repair force-reinstalls this feature and nothing else.

        Windows Installer protects an unversioned file whose modification date
        is later than its creation date: it reads that as the owner's own data
        and leaves it alone. Every repair mode except `a` honours that rule, so
        a Repair of an edited package-owned notice reported success and
        restored nothing. `a` is required, and a feature is the only thing that
        bounds which files it rewrites.

        The two executables stay in the parent feature on purpose. The console
        that asks for a repair is itself running `vadgr.exe`, and Windows
        cannot replace a running image, so forcing them fails the whole
        transaction with 1603 and `Error 1310`. They are version-compared by
        the second, unforced repair pass instead.
      -->
      <Feature Id="OwnedFiles" Title="Vadgr files" Level="1">
        <ComponentGroupRef Id="PrivatePayload" />
        <ComponentRef Id="PackageMetadata" />
        <ComponentGroupRef Id="LegalPayload" />
        <ComponentGroupRef Id="SbomPayload" />
      </Feature>
    </Feature>

    <Component Id="VadgrBackend" Directory="INSTALLFOLDER" Guid="{CE560AD1-3C47-4BE8-9844-A34E1F2A65B0}">
      <File Id="VadgrBackendFile" Source="$(var.PayloadDir)\vadgr.exe" />
      <RegistryValue Root="HKCU" Key="Software\MONTBRAIN\Vadgr\Components" Name="Backend" Type="integer" Value="1" KeyPath="yes" />
    </Component>
    <Component Id="VadgrApplication" Directory="INSTALLFOLDER" Guid="{E6A20354-0AEC-4C07-936E-021BED19E13C}">
      <File Id="VadgrApplicationFile" Source="$(var.PayloadDir)\vadgr-app.exe" />
      <RegistryValue Root="HKCU" Key="Software\MONTBRAIN\Vadgr\Components" Name="Application" Type="integer" Value="1" KeyPath="yes" />
    </Component>
    <Component Id="PackageMetadata" Directory="INSTALLFOLDER" Guid="{720A2781-42CC-4CA3-892B-3C5863957166}">
      <File Id="InstallReceiptFile" Source="$(var.PayloadDir)\install-receipt.json" />
      <File Id="OfflineReadmeFile" Source="$(var.PayloadDir)\README-OFFLINE.txt" />
      <File Id="PackageInputInventoryFile" Source="$(var.PayloadDir)\package-input-inventory.json" />
      <File Id="PackageInputReviewFile" Source="$(var.PayloadDir)\package-input-review.json" />
      <?if $(var.DevelopmentUnsigned) = true ?>
      <!-- The development admission for the bundled runtime. The install
           receipt records this file's digest, and the daemon refuses to start
           that runtime unless every byte the receipt inventories still matches.
           A release package never contains one, which is why this file is
           authored under the same condition that drops the Authenticode
           vehicle cache. -->
      <File Id="DevelopmentReceiptFile" Source="$(var.PayloadDir)\development-receipt.json" />
      <?endif?>
      <RegistryValue Root="HKCU" Key="Software\MONTBRAIN\Vadgr\Components" Name="Metadata" Type="integer" Value="1" KeyPath="yes" />
    </Component>
    <Component Id="InstallFolderCleanup" Directory="INSTALLFOLDER" Guid="{F769D82B-844F-4D60-B8CE-8F1A39032D9F}">
      <RegistryValue Root="HKCU" Key="Software\MONTBRAIN\Vadgr\Components" Name="Folders" Type="integer" Value="1" KeyPath="yes" />
      <util:RemoveFolderEx On="uninstall" Property="INSTALLFOLDER" />
      <RemoveFolder Id="RemoveLegalFolder" Directory="LegalFolder" On="uninstall" />
      <RemoveFolder Id="RemovePrivateLibFolder" Directory="PrivateLibFolder" On="uninstall" />
      <RemoveFolder Id="RemoveSbomFolder" Directory="SbomFolder" On="uninstall" />
      <RemoveFolder Id="RemoveInstallFolder" Directory="INSTALLFOLDER" On="uninstall" />
      <RemoveFolder Id="RemoveProgramsDirectory" Directory="ProgramsDirectory" On="uninstall" />
    </Component>

    <CustomAction
        Id="RecordTermsAcceptance"
        FileRef="VadgrBackendFile"
        ExeCommand="__record-terms-acceptance --terms-version &quot;[TERMSVERSION]&quot; --installer-version &quot;[ProductVersion]&quot; --terms-file &quot;[INSTALLFOLDER]legal\TERMS.txt&quot; --installer-file &quot;[BUNDLESOURCE]&quot;"
        Execute="commit"
        Impersonate="yes"
        Return="check"
        HideTarget="yes" />
    <CustomAction
        Id="PurgeOwnerState"
        FileRef="VadgrBackendFile"
        ExeCommand="__purge-owner-state"
        Execute="deferred"
        Impersonate="yes"
        Return="check"
        HideTarget="yes" />
    <CustomAction
        Id="CacheInstallVehicle"
        FileRef="VadgrBackendFile"
        ExeCommand="__cache-install-vehicle --installer-file &quot;[BUNDLESOURCE]&quot;"
        Execute="commit"
        Impersonate="yes"
        Return="check"
        HideTarget="yes" />
    <InstallExecuteSequence>
      <Custom
          Action="RecordTermsAcceptance"
          Before="InstallFinalize"
          Condition="NOT Installed AND TERMSACCEPTED = 1" />
      <?if $(var.DevelopmentUnsigned) = false ?>
      <Custom
          Action="CacheInstallVehicle"
          Before="InstallFinalize"
          Condition="NOT Installed AND TERMSACCEPTED = 1" />
      <?endif?>
      <Custom
          Action="PurgeOwnerState"
          Before="RemoveFiles"
          Condition="REMOVE~=&quot;ALL&quot; AND PURGEOWNERDATA = 1" />
    </InstallExecuteSequence>

    <Component Id="StartMenuEntry" Directory="ApplicationProgramsFolder" Guid="{F38294D0-D344-4D64-8B8A-09219AF09CA5}">
      <Shortcut
          Id="VadgrStartMenuShortcut"
          Name="Vadgr"
          Description="Open the Vadgr local machine console"
          Target="[INSTALLFOLDER]vadgr-app.exe"
          WorkingDirectory="INSTALLFOLDER" />
      <RemoveFolder Id="RemoveApplicationProgramsFolder" On="uninstall" />
      <RegistryValue
          Root="HKCU"
          Key="Software\MONTBRAIN\Vadgr"
          Name="StartMenuEntry"
          Type="integer"
          Value="1"
          KeyPath="yes" />
    </Component>

    <Component Id="StartupEntry" Directory="INSTALLFOLDER" Guid="{FCFBC40E-836E-4EA6-AB66-28658C889518}">
      <RegistryValue
          Root="HKCU"
          Key="Software\Microsoft\Windows\CurrentVersion\Run"
          Name="Vadgr"
          Type="string"
          Value="&quot;[INSTALLFOLDER]vadgr-app.exe&quot; --daemon"
          KeyPath="yes" />
    </Component>

    <Component Id="PackageCacheCleanup" Directory="PackageCacheFolder" Guid="{CD6D7B1B-FA3D-4AF6-B457-073F87A8FC55}">
      <RemoveFile Id="RemoveVadgrCachedSetups" Name="*.exe" On="uninstall" />
      <RemoveFolder Id="RemoveVadgrPackageCache" On="uninstall" />
      <RegistryValue
          Root="HKCU"
          Key="Software\MONTBRAIN\Vadgr"
          Name="PackageCache"
          Type="integer"
          Value="1"
          KeyPath="yes" />
    </Component>
  </Package>
</Wix>
