# The computer-use runtime's virtual environment, which the daemon installs.
.cu_venv/

# Python belongs to the computer-use runtime and to this repository's own
# gates, never to a checkout. A Windows virtual environment was committed here
# once, 1441 files of bytecode, and it survived the cutover because nothing
# looked for anything but `.py`.
.venv/
.venv-*/
venv/
__pycache__/
*.pyc
*.pyo

# The QR oracle is a tiny crate inside the runbook's harness; its build output is not.
E2E/*/harness/qr-decode/target/
E2E/*/harness/qr-decode/Cargo.lock
