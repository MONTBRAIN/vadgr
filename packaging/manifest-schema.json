{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vadgr.com/schemas/release-manifest-v1.json",
  "title": "Vadgr release manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "product", "version", "release_sequence", "tag",
    "source_commit", "terms_version", "terms_sha256", "cua_version",
    "python_version", "artifacts"
  ],
  "properties": {
    "schema": { "const": 1 },
    "product": { "const": "vadgr" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "release_sequence": { "type": "integer", "minimum": 1 },
    "tag": { "type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "source_commit": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" },
    "terms_version": { "type": "string", "minLength": 1 },
    "terms_sha256": { "$ref": "#/$defs/sha256" },
    "cua_version": { "type": "string", "minLength": 1 },
    "python_version": { "type": "string", "minLength": 1 },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/artifact" }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "target", "kind", "size", "sha256", "native_signature"],
      "properties": {
        "name": { "type": "string", "pattern": "^[^/\\\\]+$", "minLength": 1 },
        "target": {
          "enum": [
            "windows-x86_64", "windows-aarch64", "macos-x86_64",
            "macos-aarch64", "linux-x86_64", "linux-aarch64",
            "wsl-x86_64", "wsl-aarch64"
          ]
        },
        "kind": { "enum": ["burn", "pkg", "appimage", "tar.gz"] },
        "size": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "native_signature": {
          "enum": ["authenticode", "developer-id-notarized", "minisign-manifest"]
        }
      }
    }
  }
}
