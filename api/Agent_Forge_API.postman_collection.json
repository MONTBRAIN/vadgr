{
  "info": {
    "name": "Vadgr API",
    "description": "E2E test suite for the Vadgr API.\n\nRun order matters -- requests use collection variables set by earlier requests.\n\nFlow: Providers -> Health -> Create Agent -> Poll Ready -> Get -> Cosmetic Update -> Substantive Update -> Poll Updated -> Busy Update (409) -> Run Agent -> List Runs -> List Agents -> Minimal Create -> Validation Tests -> Delete Tests -> Runs -> Computer Use.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "run_id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Providers",
      "item": [
        {
          "name": "List Providers",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/providers"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function() {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "var json = pm.response.json();",
                  "",
                  "pm.test('Returns non-empty array', function() {",
                  "    pm.expect(json).to.be.an('array');",
                  "    pm.expect(json.length).to.be.at.least(1);",
                  "});",
                  "",
                  "pm.test('Each provider has id, name, and models', function() {",
                  "    json.forEach(function(p) {",
                  "        pm.expect(p).to.have.property('id');",
                  "        pm.expect(p).to.have.property('name');",
                  "        pm.expect(p).to.have.property('models');",
                  "        pm.expect(p.models).to.be.an('array');",
                  "    });",
                  "});",
                  "",
                  "pm.test('Claude Code provider exists with models', function() {",
                  "    var cc = json.find(function(p) { return p.id === 'claude_code'; });",
                  "    pm.expect(cc).to.not.be.undefined;",
                  "    pm.expect(cc.name).to.eql('Claude Code');",
                  "    pm.expect(cc.models.length).to.be.at.least(1);",
                  "    var modelIds = cc.models.map(function(m) { return m.id; });",
                  "    pm.expect(modelIds).to.include('claude-sonnet-4-6');",
                  "});",
                  "",
                  "pm.test('Each model has id and name', function() {",
                  "    json.forEach(function(p) {",
                  "        p.models.forEach(function(m) {",
                  "            pm.expect(m).to.have.property('id');",
                  "            pm.expect(m).to.have.property('name');",
                  "            pm.expect(m.id.length).to.be.above(0);",
                  "            pm.expect(m.name.length).to.be.above(0);",
                  "        });",
                  "    });",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/health"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function() {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Status is healthy', function() {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.status).to.eql('healthy');",
                  "});",
                  "",
                  "pm.test('Has module availability', function() {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.modules).to.have.property('forge');",
                  "    pm.expect(json.modules).to.have.property('computer_use');",
                  "});",
                  "",
                  "pm.test('Has platform info', function() {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.platform).to.be.a('string');",
                  "    pm.expect(json.version).to.be.a('string');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Runs",
      "item": [
        {
          "name": "Start Run",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/runs",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"task\": \"Summarise the files in this folder\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 202', function() {",
                  "    pm.response.to.have.status(202);",
                  "});",
                  "",
                  "var json = pm.response.json();",
                  "pm.collectionVariables.set('run_id', json.id);",
                  "",
                  "pm.test('Run has id', function() {",
                  "    pm.expect(json.id).to.be.a('string');",
                  "    pm.expect(json.id).to.have.lengthOf.above(0);",
                  "});",
                  "",
                  "pm.test('Run status is queued', function() {",
                  "    pm.expect(json.status).to.eql('queued');",
                  "});",
                  "",
                  "pm.test('Run carries the task as its name', function() {",
                  "    pm.expect(json.agent_name).to.eql('Summarise the files in this folder');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Start Run - Provider Without Model (422)",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/runs",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"task\": \"Summarise the files in this folder\",\n  \"provider\": \"codex\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 422', function() {",
                  "    pm.response.to.have.status(422);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Get Run",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/runs/{{run_id}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function() {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Run has correct id', function() {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.id).to.eql(pm.collectionVariables.get('run_id'));",
                  "});",
                  "",
                  "pm.test('Run has required fields', function() {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json).to.have.property('id');",
                  "    pm.expect(json).to.have.property('agent_id');",
                  "    pm.expect(json).to.have.property('status');",
                  "    pm.expect(json).to.have.property('inputs');",
                  "    pm.expect(json).to.have.property('outputs');",
                  "});",
                  "",
                  "pm.test('Run is linked to correct agent', function() {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.agent_id).to.eql(pm.collectionVariables.get('agent_id'));",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Get Run - 404",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/runs/nonexistent-id"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 404', function() {",
                  "    pm.response.to.have.status(404);",
                  "});",
                  "",
                  "pm.test('Error code is RUN_NOT_FOUND', function() {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.error.code).to.eql('RUN_NOT_FOUND');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "List Runs",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/runs"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function() {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Returns array', function() {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json).to.be.an('array');",
                  "    pm.expect(json.length).to.be.at.least(1);",
                  "});",
                  "",
                  "pm.test('Each run has required fields', function() {",
                  "    var json = pm.response.json();",
                  "    json.forEach(function(run) {",
                  "        pm.expect(run).to.have.property('id');",
                  "        pm.expect(run).to.have.property('status');",
                  "    });",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "List Runs - Filter by Status",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/runs?status=queued",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "runs"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "queued"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function() {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('All returned runs match filter', function() {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json).to.be.an('array');",
                  "    json.forEach(function(run) {",
                  "        pm.expect(run.status).to.eql('queued');",
                  "    });",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Cancel Run",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/runs/{{run_id}}/cancel"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function() {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Run is cancelled (failed status)', function() {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.status).to.eql('failed');",
                  "});",
                  "",
                  "pm.test('Run id matches', function() {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.id).to.eql(pm.collectionVariables.get('run_id'));",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Cancel Run - Verify Status",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/runs/{{run_id}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function() {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Run status persisted as failed', function() {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.status).to.eql('failed');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Computer Use",
      "item": [
        {
          "name": "Computer Use Status",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/computer-use/status"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function() {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Has availability info', function() {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json).to.have.property('available');",
                  "    pm.expect(json).to.have.property('platform');",
                  "});",
                  "",
                  "pm.test('Platform is a string', function() {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.platform).to.be.a('string');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    }
  ]
}
